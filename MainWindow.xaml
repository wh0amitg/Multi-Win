<Window x:Class="WinMultiInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinMultiInstaller"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="Multi-Win" Height="780" Width="700" MinHeight="740" MinWidth="660"
        ResizeMode="CanMinimize"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderLogoWrap" Width="44" Height="44" CornerRadius="12"
                    Margin="0,0,14,0" Visibility="Collapsed" Background="Transparent">
                <Image x:Name="HeaderLogo" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Multi-Win" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Windows and Linux USB installer" Opacity="0.65" FontSize="12"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="HwText" Margin="0,8,0,0" TextWrapping="Wrap"
                   Opacity="0.7" FontSize="12" Text="Detecting hardware..."/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Step1Head" Text="1 · Image" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Border x:Name="Step1Bar" Height="5" CornerRadius="3" Background="#0078D4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="Step2Head" Text="2 · USB Drive" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6" Opacity="0.5"/>
                <Border x:Name="Step2Bar" Height="5" CornerRadius="3" Background="#3A3A3A"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock x:Name="Step3Head" Text="3 · Flash" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6" Opacity="0.5"/>
                <Border x:Name="Step3Bar" Height="5" CornerRadius="3" Background="#3A3A3A"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" x:Name="Step1Panel" Margin="0,12,0,0" CornerRadius="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Choose OS image" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,0"/>
                <ComboBox x:Name="SourceBox" Margin="0,4,0,0" Height="34" SelectionChanged="SourceBox_Changed">
                    <ComboBoxItem Content="From built-in list" IsSelected="True"/>
                    <ComboBoxItem Content="From disk (local ISO file)"/>
                    <ComboBoxItem Content="From link (direct .iso URL)"/>
                </ComboBox>
                <TextBlock Text="Image" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,0"/>
                <ComboBox x:Name="ImageBox" Margin="0,4,0,0" Height="38">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="28" Height="28" Margin="0,0,10,0">
                                    <Grid x:Name="WinIcon" Visibility="Collapsed">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Background="#0078D4" CornerRadius="2" Margin="0,0,1,1"/>
                                        <Border Grid.Column="1" Background="#0078D4" CornerRadius="2" Margin="1,0,0,1"/>
                                        <Border Grid.Row="1" Background="#0078D4" CornerRadius="2" Margin="0,1,1,0"/>
                                        <Border Grid.Row="1" Grid.Column="1" Background="#0078D4" CornerRadius="2" Margin="1,1,0,0"/>
                                    </Grid>
                                    <Canvas x:Name="LinIcon" Visibility="Collapsed" Width="28" Height="28">
                                        <Ellipse Canvas.Left="7" Canvas.Top="22" Width="5" Height="4" Fill="#F29900"/>
                                        <Ellipse Canvas.Left="16" Canvas.Top="22" Width="5" Height="4" Fill="#F29900"/>
                                        <Ellipse Canvas.Left="6" Canvas.Top="3" Width="16" Height="21" Fill="#1F1F1F"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="9" Width="9" Height="13" Fill="White"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="6" Width="4.5" Height="5" Fill="White"/>
                                        <Ellipse Canvas.Left="14" Canvas.Top="6" Width="4.5" Height="5" Fill="White"/>
                                        <Ellipse Canvas.Left="11" Canvas.Top="7.5" Width="2" Height="2.5" Fill="#1F1F1F"/>
                                        <Ellipse Canvas.Left="15.5" Canvas.Top="7.5" Width="2" Height="2.5" Fill="#1F1F1F"/>
                                        <Polygon Points="11,11 17,11 14,14.5" Fill="#F29900"/>
                                    </Canvas>
                                    <Grid x:Name="GenIcon" Visibility="Collapsed">
                                        <Ellipse Stroke="#0078D4" StrokeThickness="2" Margin="3"/>
                                        <Ellipse Fill="#0078D4" Width="6" Height="6"/>
                                    </Grid>
                                    <Image Source="{Binding IconPath}" Stretch="Uniform"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Arch}" Opacity="0.6" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding OsFamily}" Value="Windows">
                                    <Setter TargetName="WinIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OsFamily}" Value="Linux">
                                    <Setter TargetName="LinIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OsFamily}" Value="Unknown">
                                    <Setter TargetName="GenIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel x:Name="BrowsePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button Content="Browse ISO file..." Height="34" Click="BrowseIso_Click"/>
                    <TextBlock Text="...or drop an .iso anywhere on this window." Opacity="0.55" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="UrlPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Height="34" VerticalContentAlignment="Center" ToolTip="https://.../file.iso" KeyDown="UrlBox_KeyDown"/>
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Add" Height="34" MinWidth="80" Click="AddUrl_Click"/>
                </Grid>
                <TextBlock x:Name="ImageDesc" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CacheText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Clear cache" Height="28" MinWidth="90" Click="ClearCache_Click" ToolTip="Delete downloaded ISOs in %TEMP%\Multi-Win" Opacity="0.85"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" x:Name="Step2Panel" Margin="0,12,0,0" CornerRadius="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Choose USB drive" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="All data on the drive will be erased!" Opacity="0.6" FontSize="12"/>
                <TextBlock Text="Drive" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="UsbBox" Height="34" DisplayMemberPath="Display"/>
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Refresh" Click="RefreshUsb_Click" Height="34" MinWidth="100"/>
                </Grid>
                <TextBlock Text="File system &amp; label" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FsBox" Height="34" ToolTip="FAT32 splits install.wim (BIOS+UEFI safe). NTFS is fast, no split.">
                        <ComboBoxItem Content="FAT32 (split, BIOS+UEFI safe)" IsSelected="True"/>
                        <ComboBoxItem Content="NTFS (fast, no split)"/>
                    </ComboBox>
                    <Button Grid.Column="1" x:Name="BenchBtn" Margin="10,0,0,0" Content="Test speed" Click="Bench_Click" Height="34" MinWidth="100" ToolTip="Sequential write/read benchmark"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume label:" VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="LabelBox" Height="32" VerticalContentAlignment="Center" MaxLength="11" Text="MULTIWIN" ToolTip="USB drive name after formatting (up to 11 characters)"/>
                </Grid>
                <TextBlock x:Name="BenchText" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                <TextBlock Text="Checks" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,0"/>
                <CheckBox x:Name="BadBlocksCheck" Margin="0,4,0,0" Content="Check for bad blocks before flash (slow)"/>
                <CheckBox x:Name="VerifyCheck" Margin="0,4,0,0" Content="Verify files after flash (recommended)" IsChecked="True"/>
            <CheckBox x:Name="BypassCheck" Margin="0,14,0,0" Content="Bypass TPM / SecureBoot check (Win11 only)"/>
            <StackPanel x:Name="WinTweaks" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Windows setup tweaks" FontWeight="SemiBold"/>
                <CheckBox x:Name="BypassNroCheck" Margin="0,6,0,0" Content="Skip online Microsoft account"/>
                <TextBlock Text="Local username (blank = skip, blank password + autologon):" Opacity="0.7" Margin="0,6,0,0"/>
                <TextBox x:Name="UserNameBox" Height="32" VerticalContentAlignment="Center" MaxLength="20"/>
                <CheckBox x:Name="PrivacyCheck" Margin="0,6,0,0" Content="Skip privacy questions"/>
                <CheckBox x:Name="BitLockerCheck" Margin="0,2,0,0" Content="Prevent automatic BitLocker encryption"/>
                <CheckBox x:Name="AppraiserCheck" Margin="0,2,0,0" Content="Empty appraiserres.dll (in-place upgrade without TPM)"/>
                <CheckBox x:Name="LocaleCheck" Margin="0,2,0,0" Content="Use this PC's timezone" IsChecked="True"/>
            </StackPanel>
                <TextBlock x:Name="WarnText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#D83B01"/>
                </StackPanel>
                </ScrollViewer>
        </Border>

        <Border Grid.Row="3" x:Name="Step3Panel" Margin="0,12,0,0" CornerRadius="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Download &amp; flash" FontSize="16" FontWeight="SemiBold"/>
                <Border Margin="0,10,0,0" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.85" FontSize="12"/>
                </Border>
                <ProgressBar x:Name="Progress" Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" Text="Ready" Opacity="0.8" FontSize="12"/>
                <TextBlock x:Name="SpeedText" Margin="0,2,0,0" FontSize="12" Opacity="0.7" Text=""/>
                <Border Margin="0,8,0,0" CornerRadius="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                    <ListBox x:Name="LogBox" Height="220" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Button Content="Save log..." Margin="0,8,0,0" Height="28" Click="SaveLog_Click" HorizontalAlignment="Right" MinWidth="110" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackBtn" Content="← Back" MinWidth="110" Height="32" Click="Back_Click" IsEnabled="False"/>
              <TextBlock Grid.Column="1" Text="Multi-Win • v0.5" Opacity="0.35" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="NextBtn" Content="Next →" MinWidth="120" Height="32"
                    Style="{StaticResource AccentButtonStyle}" Click="Next_Click"/>
            <Button Grid.Column="2" x:Name="StartBtn" Content="Flash" MinWidth="140" Height="32"
                    Style="{StaticResource AccentButtonStyle}" Click="Start_Click" Visibility="Collapsed"/>
            <Button Grid.Column="2" x:Name="CancelBtn" Content="Cancel" MinWidth="140" Height="32"
                    Click="CancelBtn_Click" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
